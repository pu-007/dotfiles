_omp() {
	local curcontext="$curcontext" state line
	typeset -A opt_args
	_arguments -C -s \
		'(-h --help)'{-h,--help}'[Show help]' \
		'(-v --version)'{-v,--version}'[Show version]' \
		'--model[Model to use (fuzzy match  "opus", "gpt-5.2"; exact with a provider  "openai/gpt-5.2")]:model:_omp_call models' \
		'--smol[Smol/fast model for lightweight tasks (or PI_SMOL_MODEL env)]:model:_omp_call models' \
		'--slow[Slow/reasoning model for thorough analysis (or PI_SLOW_MODEL env)]:model:_omp_call models' \
		'--plan[Plan model for architectural planning (or PI_PLAN_MODEL env)]:model:_omp_call models' \
		'--goal[Start fresh in goal mode (interactive only; bypasses autoResume; no positional prompt, startup plan mode, or explicit resume)]:file:_files' \
		'--prewalk[Switch from the active model to a fast/cheap model at the first edit/write after the plan’s todo list exists (default off; see prewalk.enabled)]' \
		'--no-prewalk[Disable prewalk, including prewalk.auto, even if prewalk.enabled is set]' \
		'--prewalk-into[Target model for prewalk (default the "smol" role)]:file:_files' \
		'--plan-yolo[Force read-only plan mode at start, auto-approve the plan on the model’s first resolve call, then switch to --plan-yolo-into to implement it]' \
		'--plan-yolo-into[Target model for plan-yolo execution (default the "smol" role)]:file:_files' \
		'--provider[Provider to use (legacy; prefer --model)]:file:_files' \
		'--api-key[API key (defaults to env vars)]:file:_files' \
		'--system-prompt[System prompt (default  coding assistant prompt)]:file:_files' \
		'--system-prompt-template[Handlebars system prompt template (mutually exclusive with --system-prompt)]:file:_files' \
		'--append-system-prompt[Append text or file contents to the system prompt]:file:_files' \
		'--allow-home[Allow starting in ~ without auto-switching to a temp dir]' \
		'--profile[Use an isolated profile for auth, sessions, settings, and caches]:file:_files' \
		'--alias[Create a shell shortcut for the selected profile and exit]:file:_files' \
		'--cwd[Directory to start in (overrides the launch cwd)]:file:_files' \
		'--mode[Output mode  text (default), json, rpc, or rpc-ui]:value:(text json rpc acp rpc-ui)' \
		'*--config[Load an extra config.yml-style overlay for this run (repeatable)]:file:_files' \
		'*--add-dir[Add a workspace directory beyond the working directory (repeatable)]:file:_files' \
		'(-p --print)'{-p,--print}'[Non-interactive mode  process prompt and exit]' \
		'(-c --continue)'{-c,--continue}'[Continue previous session]' \
		'(-r --resume)'{-r,--resume}'[Resume a session (by ID prefix, path, or picker if omitted)]:session:_omp_call sessions' \
		'--restore[Resume a session as --resume does, then go on with what its last process left unfinished (the interrupted turn and the subagents it was running)]:session:_omp_call sessions' \
		'--from-claude[Import a Claude Code session into OMP]' \
		'--from-codex[Import a Codex session into OMP]' \
		'--session-dir[Directory for session storage and lookup]:dir:_files -/' \
		'--no-session[Don’t save session (ephemeral)]' \
		'--models[Comma-separated model patterns for Ctrl+P cycling]:models:_omp_models_list' \
		'--no-tools[Disable all built-in tools]' \
		'--no-lsp[Disable LSP tools, formatting, and diagnostics]' \
		'--no-pty[Disable PTY-based interactive bash execution]' \
		'--tools[Comma-separated built-in or extension tool names to enable (default  tools enabled in settings; see Built-in Tools)]:value:_omp_tools' \
		'--thinking[Set thinking level  off, minimal, low, medium, high, xhigh, max, auto]:value:(off minimal low medium high xhigh max auto)' \
		'--service-tier[OpenAI service tier for this session (none omits service_tier)]:value:(none auto default flex scale priority ultrafast)' \
		'--hide-thinking[Hide thinking blocks in TUI output (display only, does not disable model thinking)]' \
		'--advisor[Enable the advisor runtime (passively reviews each turn and injects notes)]' \
		'--wait-async[Print mode  before exiting, wait for this run’s background jobs and wake the session with each result (async.printWake); no time limit unless --max-time is set]' \
		'--external-thinking[Use a private scratchpad while disabling supported GPT, Claude, and Gemini reasoning (at your own risk  providers have flagged this request shape as abuse)]' \
		'*--hook[Load a hook/extension file (can be used multiple times)]:file:_files' \
		'*'{-e,--extension}'[Load an extension file (can be used multiple times)]:file:_files' \
		'--no-extensions[Disable extension discovery (explicit -e paths still work)]' \
		'--no-skills[Disable skills discovery and loading]' \
		'--skills[Comma-separated glob patterns to filter skills (e.g., git-*,docker)]:file:_files' \
		'--no-rules[Disable rules discovery and loading]' \
		'--no-context-files[Disable context files (AGENTS.md, CLAUDE.md, ...)]' \
		'--export[Export session file to HTML and exit]:file:_files' \
		'--no-title[Disable title auto-generation]' \
		'--spinner-interval[Milliseconds between spinner frames (default 80; 0 = static). Overrides tui.spinnerInterval and PI_SPINNER_INTERVAL for this run]:file:_files' \
		'--max-fps[Repaint ceiling in frames per second (default 30; 1-120); keystroke echo keeps 30 fps. Overrides tui.maxFps and PI_MAX_FPS for this run]:file:_files' \
		'--motion[Animation preset  full (default), reduced (250 ms spinners, no shimmer or blink), or none (static). Overrides tui.motion and PI_MOTION for this run]:file:_files' \
		'--no-ui[With --mode rpc or rpc-ui  run extensions headless (rpc-ui tool UI remains enabled)]' \
		'--print-thoughts[Include thinking blocks in print mode text output]' \
		'--max-time[Stop the session after this duration (e.g., 600, 10m, 1h)]:file:_files' \
		'--warn-cost[Warn once when the session’s spend, subagents included, reaches this many USD]:file:_files' \
		'--max-cost[Stop sending model requests once the session’s spend reaches this many USD; requests already in flight can finish past it (print mode exits 3)]:file:_files' \
		'--auto-approve[Auto-approve all tool calls (skip approval prompts)]' \
		'--approval-mode[Override tools.approvalMode for this session (always-ask|always-ask-cached|write|yolo)]:value:(always-ask always-ask-cached write yolo)' \
		'1: :_omp_commands' \
		'*::arg:->args'
	case $state in
		args)
			case $line[1] in
			acp) _omp_cmd_acp ;;
			agents) _omp_cmd_agents ;;
			anonymize) _omp_cmd_anonymize ;;
			auth) _omp_cmd_auth ;;
			auth-broker) _omp_cmd_auth_broker ;;
			auth-gateway) _omp_cmd_auth_gateway ;;
			bash) _omp_cmd_bash ;;
			bench) _omp_cmd_bench ;;
			browser-relay) _omp_cmd_browser_relay ;;
			cleanse) _omp_cmd_cleanse ;;
			clip) _omp_cmd_clip ;;
			collab) _omp_cmd_collab ;;
			commit) _omp_cmd_commit ;;
			completions) _omp_cmd_completions ;;
			compress) _omp_cmd_compress ;;
			config) _omp_cmd_config ;;
			dry-balance) _omp_cmd_dry_balance ;;
			find) _omp_cmd_find ;;
			gallery) _omp_cmd_gallery ;;
			gc) _omp_cmd_gc ;;
			git) _omp_cmd_git ;;
			grep) _omp_cmd_grep ;;
			grievances) _omp_cmd_grievances ;;
			if-bench) _omp_cmd_if_bench ;;
			images|img) _omp_cmd_images ;;
			install) _omp_cmd_install ;;
			join) _omp_cmd_join ;;
			login) _omp_cmd_login ;;
			models) _omp_cmd_models ;;
			play) _omp_cmd_play ;;
			plugin|plugins) _omp_cmd_plugin ;;
			predict) _omp_cmd_predict ;;
			ps) _omp_cmd_ps ;;
			read) _omp_cmd_read ;;
			render) _omp_cmd_render ;;
			say) _omp_cmd_say ;;
			search|q|web-search) _omp_cmd_search ;;
			session) _omp_cmd_session ;;
			setup) _omp_cmd_setup ;;
			sh) _omp_cmd_sh ;;
			share) _omp_cmd_share ;;
			shell) _omp_cmd_shell ;;
			skill|skills) _omp_cmd_skill ;;
			ssh) _omp_cmd_ssh ;;
			stats) _omp_cmd_stats ;;
			stream) _omp_cmd_stream ;;
			tiny-models) _omp_cmd_tiny_models ;;
			token) _omp_cmd_token ;;
			toks) _omp_cmd_toks ;;
			ttsr) _omp_cmd_ttsr ;;
			update) _omp_cmd_update ;;
			usage) _omp_cmd_usage ;;
			worktree|wt) _omp_cmd_worktree ;;
			zsh) _omp_cmd_zsh ;;
			esac
			;;
	esac
}
# Works both ways: autoloaded from $fpath (file named _omp) or eval'd from a
# startup file. When autoloaded, funcstack[1] is _omp and we invoke it; when
# sourced/eval'd we register it with compdef instead.
if [ "$funcstack[1]" = "_omp" ]; then
	_omp "$@"
else
	compdef _omp omp
fi

